---
import { SITE } from "../config/site";
import { darkToken } from "../lib/theme";
import { withBase } from "../lib/url";
import ThemePicker from "../components/ThemePicker.astro";
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/motion.css";

interface Props {
    title?: string;
    description?: string;
    type?: "website" | "article";
    ogTitle?: string;
    ogImage?: string;
    published?: Date;
}

const {
    title = SITE.title,
    description = SITE.description,
    type = "website",
    ogTitle = title,
    ogImage = "/og/home.png",
    published,
} = Astro.props;
const pageUrl = new URL(Astro.url.pathname, SITE.url).href;
const ogImageUrl = new URL(withBase(ogImage), SITE.url).href;
const fontUrl = withBase("/fonts/Figtree-Variable.woff2");
const fontFace = `@font-face {
    font-family: "Figtree";
    src: url("${fontUrl}") format("woff2");
    font-weight: 300 900;
    font-style: normal;
    font-display: swap;
}`;
const favicon = `data:image/svg+xml,${encodeURIComponent(
    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><text y=".9em" font-size="90">${SITE.emoji}</text></svg>`,
)}`;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <script is:inline>
            try {
                const theme = localStorage.getItem("theme");
                if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
            } catch {}
        </script>
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={pageUrl} />
        <link rel="icon" href={favicon} />
        <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
        <style is:inline set:html={fontFace}></style>

        <meta property="og:type" content={type} />
        <meta property="og:site_name" content={SITE.name} />
        <meta property="og:locale" content="en_US" />
        <meta property="og:title" content={ogTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={pageUrl} />
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:secure_url" content={ogImageUrl} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content={SITE.ogImage.width} />
        <meta property="og:image:height" content={SITE.ogImage.height} />
        <meta property="og:image:alt" content={`${ogTitle} · ${SITE.name}`} />
        {published && <meta property="article:published_time" content={published.toISOString()} />}
        {type === "article" && <meta property="article:author" content={SITE.socials.github} />}
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image:alt" content={`${ogTitle} · ${SITE.name}`} />
        <meta name="theme-color" content={darkToken("accent")} />
    </head>
    <body>
        <ThemePicker />
        <div class="column">
            <slot />
        </div>
    </body>
</html>

<style>
    .column {
        max-width: calc(var(--column-width) + 2 * var(--gutter));
        margin-inline: auto;
        padding: 4rem var(--gutter) 2rem;
    }
</style>
