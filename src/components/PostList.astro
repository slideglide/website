---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../lib/posts";
import { withBase } from "../lib/url";

interface Props {
    posts: CollectionEntry<"blog">[];
    heading: "h2" | "h3";
}

const { posts, heading: Heading } = Astro.props;
---

<ul>
    {
        posts.map(({ id, data }) => (
            <li>
                <Heading class="title">
                    <a href={withBase(`/blog/${id}/`)}>{data.title}</a>
                </Heading>
                {data.description && <p>{data.description}</p>}
                <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
            </li>
        ))
    }
</ul>

<style>
    ul {
        margin: -0.75rem 0;
        padding: 0;
        list-style: none;
    }

    li {
        padding-block: 0.75rem;
    }

    li + li {
        border-top: var(--border-width) solid var(--border);
    }

    .title {
        margin: 0 0 0.125rem;
        font-size: 1.25rem;
        font-weight: 600;
        line-height: 1.3;
        overflow-wrap: anywhere;
    }

    p {
        margin: 0 0 0.375rem;
        font-size: 1rem;
        overflow-wrap: anywhere;
    }

    time {
        display: block;
        color: var(--text-muted);
        font-size: 0.875rem;
    }
</style>
