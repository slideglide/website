---
import { PROJECTS } from "../data/projects";
import Section from "./Section.astro";
---

<Section id="projects-heading" title="Projects">
    <ul>
        {
            PROJECTS.map(({ name, description, language, dot, license, url, codeberg }) => (
                <li class="project">
                    <h3>
                        <a href={url} target="_blank" rel="noopener">{name}</a>
                    </h3>
                    <p>{description}</p>
                    <div class="meta">
                        <span class="language">
                            <span class="dot" style={`background: var(--dot-${dot})`} aria-hidden="true" />
                            {language}
                        </span>
                        {license && <span>{license}</span>}
                        {codeberg && <a href={codeberg} target="_blank" rel="noopener">Also on Codeberg</a>}
                    </div>
                </li>
            ))
        }
    </ul>
</Section>

<style>
    ul {
        margin: -0.75rem 0;
        padding: 0;
        list-style: none;
    }

    .project {
        padding-block: 0.75rem;
    }

    .project + .project {
        border-top: var(--border-width) solid var(--border);
    }

    h3 {
        margin: 0 0 0.125rem;
        font-size: 1.25rem;
        font-weight: 600;
        line-height: 1.3;
        overflow-wrap: anywhere;
    }

    p {
        margin: 0 0 0.375rem;
        font-size: 1rem;
        overflow-wrap: anywhere;
    }

    .meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.125rem 1rem;
        color: var(--text-muted);
        font-size: 0.875rem;
    }

    .language {
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    .dot {
        flex-shrink: 0;
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 50%;
        transition: transform 0.15s ease;
    }

    .project:hover .dot {
        transform: scale(1.4);
    }
</style>
