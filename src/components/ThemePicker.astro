<fieldset id="theme-picker" hidden>
    <legend class="visually-hidden">Theme</legend>
    <label title="Light">
        <input type="radio" name="theme" value="light" />
        <span class="visually-hidden">Light</span>
        <svg viewBox="0 0 16 16" aria-hidden="true">
            <circle cx="8" cy="8" r="3" />
            <path d="M8 1.5v1.5M8 13v1.5M1.5 8H3M13 8h1.5M3.4 3.4l1.1 1.1M11.5 11.5l1.1 1.1M3.4 12.6l1.1-1.1M11.5 4.5l1.1-1.1" />
        </svg>
    </label>
    <label title="Dark">
        <input type="radio" name="theme" value="dark" />
        <span class="visually-hidden">Dark</span>
        <svg viewBox="0 0 16 16" aria-hidden="true">
            <path d="M13.5 9.7A5.8 5.8 0 0 1 6.3 2.5a5.8 5.8 0 1 0 7.2 7.2Z" />
        </svg>
    </label>
    <label title="System">
        <input type="radio" name="theme" value="system" />
        <span class="visually-hidden">System</span>
        <svg viewBox="0 0 16 16" aria-hidden="true">
            <rect x="1.5" y="2.5" width="13" height="9" rx="1.5" />
            <path d="M5.5 14h5M8 11.5V14" />
        </svg>
    </label>
</fieldset>

<script>
    const picker = document.querySelector<HTMLFieldSetElement>("#theme-picker")!;
    const current = document.documentElement.dataset.theme ?? "system";

    for (const input of picker.querySelectorAll<HTMLInputElement>("input")) {
        input.checked = input.value === current;
        input.addEventListener("change", () => {
            if (input.value === "system") delete document.documentElement.dataset.theme;
            else document.documentElement.dataset.theme = input.value;
            try {
                if (input.value === "system") localStorage.removeItem("theme");
                else localStorage.setItem("theme", input.value);
            } catch {
            }
        });
    }

    picker.hidden = false;
</script>

<style>
    fieldset {
        display: flex;
        position: absolute;
        top: 0.75rem;
        right: var(--gutter);
        z-index: 1;
        margin: 0;
        padding: 0;
        border: 0;
    }

    fieldset[hidden] {
        display: none;
    }

    @media (min-width: 1000px) {
        fieldset {
            position: fixed;
        }
    }

    label {
        display: grid;
        position: relative;
        place-items: center;
        width: 2.25rem;
        height: 2.25rem;
        border: var(--border-width) solid var(--border);
        background: var(--bg-page);
        color: var(--text-muted);
        cursor: pointer;
        transition:
            color 0.15s ease,
            background-color 0.15s ease;
    }

    label + label {
        margin-left: calc(-1 * var(--border-width));
    }

    label:first-of-type {
        border-radius: var(--radius) 0 0 var(--radius);
    }

    label:last-of-type {
        border-radius: 0 var(--radius) var(--radius) 0;
    }

    label:hover {
        background: var(--bg-surface);
        color: var(--text-primary);
    }

    label:has(:checked) {
        background: var(--bg-surface);
        color: var(--accent);
    }

    label:has(:focus-visible) {
        z-index: 1;
        outline: 2px solid var(--accent);
        outline-offset: 2px;
    }

    input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }

    svg {
        width: 1.125rem;
        height: 1.125rem;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.25;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
    }
</style>
