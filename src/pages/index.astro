---
import { SITE } from "../config/site";
import Layout from "../layouts/Layout.astro";
import Bio from "../components/Bio.astro";
import Footer from "../components/Footer.astro";
import BlogSection from "../components/BlogSection.astro";
import Projects from "../components/Projects.astro";
import SocialLinks from "../components/SocialLinks.astro";
import Terminal from "../components/Terminal.astro";
---

<Layout>
    <main>
        <header>
            <h1><span class="emoji">{SITE.emoji}</span> Hi, I'm {SITE.shortName}!</h1>
            <SocialLinks />
        </header>
        <Bio />
        <Projects />
        <BlogSection />
    </main>
    <Footer />
    <Terminal />
</Layout>

<script>
    const emoji = document.querySelector<HTMLElement>(".emoji")!;
    emoji.addEventListener("pointerenter", () => {
        const [sway] = emoji.getAnimations();
        if (sway?.playState !== "finished") return;
        sway.effect?.updateTiming({ delay: 0 });
        sway.play();
    });
</script>

<style>
    header {
        padding-bottom: 2.5rem;
    }

    .emoji {
        display: inline-block;
        transform-origin: 30% 90%;
        animation: sway 1s ease-in-out 0.4s forwards;
    }

    @keyframes sway {
        25% {
            transform: rotate(-9deg);
        }

        60% {
            transform: rotate(6deg);
        }
    }
</style>
